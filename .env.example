# Comunidad: completar después de aplicar la migración y configurar el correo.
# Solo la clave PUBLICABLE. No usar service_role ni claves secretas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origen público para enlaces canónicos; obligatorio al activar artículos.
# Usar origen propio en pruebas.
NEXT_PUBLIC_SITE_URL=https://autismo.ar

# Analítica: solo en el servicio Railway production y dominio autismo.ar.
# Token público de captura (phc_), nunca una API key personal (phx_).
# Dejar sin configurar en test y desarrollo local. Ver docs/ANALITICA.md.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_TOKEN=

# Habilitar solo después de aplicar y verificar la migración en la base elegida.
# El host esperado evita activar accidentalmente una conexión de otro entorno.
ARTICLES_ENABLED=false
ARTICLES_EXPECTED_SUPABASE_HOST=

EXCHANGES_ENABLED=false
EXCHANGES_EXPECTED_SUPABASE_HOST=
# Opcionales de búsquedas: solo servidor. Detalles en docs/BUSQUEDAS.md.
EXCHANGES_SUPABASE_SECRET_KEY=
EXCHANGES_WORKER_TOKEN=
EXCHANGES_EMAIL_DAILY_BUDGET=0
EXCHANGES_RESEND_API_KEY=
EXCHANGES_EMAIL_FROM=
EXCHANGES_SITE_URL=
